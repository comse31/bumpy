[bootstrap]
main_collection = /main/main.collectionc
render = /main/render/game.renderc

[script]
shared_state = 1

[collection]
max_instances = 512

[mesh]
max_count = 512

[display]
width = 960
height = 720
high_dpi = 1

[android]
input_method = HiddenInputField

[engine]
fixed_update_frequency = 120
max_time_step = 0.033333

[physics]
gravity_y = -1000.0
scale = 0.01
use_fixed_timestep = 1

[html5]
scale_mode = stretch
use_indexeddb = 1


[bumpy]
controls_mode = "auto"
camera_mode = "auto"
levels_path = ""

[project]
title = bumpy
version = 1.0.0
custom_resources = /main/levels.json,/main/test_levels.json

