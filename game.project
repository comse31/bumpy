[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[collection]
max_instances = 512

[mesh]
max_count = 512

[display]
width = 960
height = 720
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = bumpy
version = 1.0.0
custom_resources = /main/levels.json

