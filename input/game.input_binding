# Сенсорное управление: экранные кнопки-кружки (main/controls/controls.gui_script).
# Действие "touch" доставляет сырые touch-события (фазы/координаты) в GUI-скрипт,
# который определяет нажатую кнопку и отправляет команду в main/ball/ball.script.
touch_trigger {
  input: TOUCH_MULTI
  action: "touch"
}
# "any_key": прочие клавиши — нужны, чтобы по любому нажатию перезапустить
# игру после GAME OVER (см. ball.script). Клавиши, уже занятые выше
# (SPACE/UP/LEFT/RIGHT/T), сюда не дублируются: ball.on_input реагирует
# на любое из связанных действий.
