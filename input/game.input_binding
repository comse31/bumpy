# --- Стартовое меню (main/ui/menu/menu.gui_script) ---
# ввод произвольного текста для имени игрока: action.text содержит символ
text_trigger {
  input: TEXT
  action: "text"
}
key_trigger {
  input: KEY_F2
  action: "edit_name"
}
key_trigger {
  input: KEY_ENTER
  action: "name_enter"
}
key_trigger {
  input: KEY_BACKSPACE
  action: "name_backspace"
}
key_trigger {
  input: KEY_ESC
  action: "name_cancel"
}
# Выбор пункта меню цифрами 1/2 обрабатывается в меню по действию "text":
# text-триггер перехватывает печатные клавиши раньше key-триггеров, поэтому
# отдельные key_trigger для цифр до скрипта меню не доходили бы.
key_trigger {
  input: KEY_SPACE
  action: "jump"
}
key_trigger {
  input: KEY_UP
  action: "jump"
}
key_trigger {
  input: KEY_LEFT
  action: "left"
}
key_trigger {
  input: KEY_RIGHT
  action: "right"
}
# Кнопка «вниз»: прерывает высокий прыжок — мяч перестаёт подниматься и
# падает из той ячейки, в которой находится в момент нажатия
key_trigger {
  input: KEY_DOWN
  action: "down"
}
key_trigger {
  input: KEY_T
  action: "switch"
}
# Сенсорное управление: экранные кнопки-кружки (main/controls/controls.gui_script).
# Действие "touch" доставляет сырые touch-события (фазы/координаты) в GUI-скрипт,
# который определяет нажатую кнопку и отправляет команду в main/ball/ball.script.
touch_trigger {
  input: TOUCH_MULTI
  action: "touch"
}
# Мышь как источник того же действия: режим "тап по ячейке"
# (bumpy.controls_mode = "cells") удобно проверять и на настольной сборке.
mouse_trigger {
  input: MOUSE_BUTTON_1
  action: "touch"
}
# Клик левой кнопкой мыши для СТАРТОВОГО МЕНЮ. Отдельное имя действия, потому
# что в Defold touch-триггер нельзя связать с тем же действием, что и
# мышиный: с общим именем mouse-события до скрипта не доходят.
mouse_trigger {
  input: MOUSE_BUTTON_LEFT
  action: "click"
}
# "any_key": прочие клавиши — нужны, чтобы по любому нажатию перезапустить
# игру после GAME OVER (см. ball.script). Клавиши, уже занятые выше
# (SPACE/UP/DOWN/LEFT/RIGHT/T, Enter/Esc/Backspace), сюда не дублируются:
# ball.on_input реагирует на любое из связанных действий.
key_trigger {
