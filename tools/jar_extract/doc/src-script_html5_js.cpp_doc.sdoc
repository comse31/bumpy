elements {
  type: FUNCTION
  name: "html5.run"
  brief: "run JavaScript code, in the browser, from Lua"
  description: "Executes the supplied string as JavaScript inside the browser.\nA call to this function is blocking, the result is returned as-is, as a string.\n(Internally this will execute the string using the `eval()` JavaScript function.)"
  returnvalues {
    name: "result"
    doc: "result as string"
    types: "string"
  }
  parameters {
    name: "code"
    doc: "Javascript code to run"
    types: "string"
    is_optional: false
  }
  examples: "```lua\nlocal res = html5.run(\"10 + 20\") -- returns the string \"30\"\nprint(res)\nlocal res_num = tonumber(res) -- convert to number\nprint(res_num - 20) -- prints 10\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "html5.set_interaction_listener"
  brief: "set a JavaScript interaction listener callback from lua"
  description: "Set a JavaScript interaction listener callaback from lua that will be\ninvoked when a user interacts with the web page by clicking, touching or typing.\nThe callback can then call DOM restricted actions like requesting a pointer lock,\nor start playing sounds the first time the callback is invoked."
  parameters {
    name: "callback"
    doc: "The interaction callback. Pass an empty function or `nil` if you no longer wish to receive callbacks.\n\n`self`\n: [type:script_instance] The calling script instance"
    types: "fun(self:script_instance)"
    types: "nil"
    is_optional: false
  }
  examples: "```lua\nlocal function on_interaction(self)\n    print(\"on_interaction called\")\n    html5.set_interaction_listener(nil)\nend\n\nfunction init(self)\n    html5.set_interaction_listener(on_interaction)\nend\n```"
  language: ""
}
