  }
  members {
    name: "m_UserData1"
    doc: "User data pointer"
    type: "uintptr_t"
  }
  members {
    name: "m_UserData2"
    doc: "User data pointer"
    type: "uintptr_t"
  }
  members {
    name: "m_Descriptor"
    doc: "User specified descriptor of the message data"
    type: "uintptr_t"
  }
  members {
    name: "m_DataSize"
    doc: "Size of message data in bytes"
    type: "uint32_t"
  }
  members {
    name: "m_Next"
    doc: "Ptr to next message (or 0 if last)"
    type: "dmMessage::Message*"
  }
  members {
    name: "m_DestroyCallback"
    doc: "If set, will be called after each dispatch"
    type: "dmMessage::MessageDestroyCallback"
  }
  members {
    name: "m_Data"
    doc: "Payload"
    type: "uint8_t*"
  }
  language: ""
}
elements {
  type: FUNCTION
  name: "Post"
  brief: "Post an message to a socket"
  description: "Post an message to a socket"
  returnvalues {
    name: "RESULT_OK"
    doc: "if the message was posted"
    types: ""
  }
  parameters {
    name: "sender"
    doc: "The sender URL if the receiver wants to respond. 0x0 is accepted"
    types: "dmMessage::URL*"
    is_optional: false
  }
  parameters {
    name: "receiver"
    doc: "The receiver URL, must not be 0x0"
    types: "dmMessage::URL*"
    is_optional: false
  }
  parameters {
    name: "message_id"
    doc: "Message id"
    types: "dmhash_t"
    is_optional: false
  }
  parameters {
    name: "user_data1"
    doc: "User data that can be used when both the sender and receiver are known"
    types: "uintptr_t"
    is_optional: false
  }
  parameters {
    name: "user_data2"
    doc: "User data that can be used when both the sender and receiver are known."
    types: "uintptr_t"
    is_optional: false
  }
  parameters {
    name: "descriptor"
    doc: "User specified descriptor of the message data"
    types: "uintptr_t"
    is_optional: false
  }
  parameters {
    name: "message_data"
    doc: "Message data reference"
    types: "void*"
    is_optional: false
  }
  parameters {
    name: "message_data_size"
    doc: "Message data size in bytes"
    types: "uint32_t"
    is_optional: false
  }
  parameters {
    name: "destroy_callback"
    doc: "if set, will be called after each message dispatch"
    types: "dmMessage::MessageDestroyCallback"
    is_optional: false
  }
  examples: ""
  notes: "Message data is copied by value"
  language: ""
}
elements {
  type: FUNCTION
  name: "PostDDF"
  brief: "post a ddf message to a socket"
  description: "Post a DDF message to a socket. A helper wrapper for Post()\'ing a DDF message"
  returnvalues {
    name: "RESULT_OK"
    doc: "if the message was posted"
    types: ""
  }
  parameters {
    name: "message"
    doc: "Message data reference"
    types: "T*"
    is_optional: false
  }
  parameters {
    name: "sender"
    doc: "The sender URL if the receiver wants to respond. 0x0 is accepted"
    types: "dmMessage::URL*"
    is_optional: false
  }
  parameters {
    name: "receiver"
    doc: "The receiver URL, must not be 0x0"
    types: "dmMessage::URL*"
    is_optional: false
  }
  parameters {
    name: "user_data1"
    doc: "User data that can be used when both the sender and receiver are known"
    types: "uintptr_t"
    is_optional: false
  }
  parameters {
    name: "user_data2"
    doc: "User data that can be used when both the sender and receiver are known."
    types: "uintptr_t"
    is_optional: false
  }
  parameters {
    name: "destroy_callback"
    doc: "if set, will be called after each message dispatch"
    types: "dmMessage::MessageDestroyCallback"
    is_optional: false
  }
  examples: "```cpp\n// dmMessage::URL sender, receiver;\n// dmGameObject::HInstance go;\n\ndmGameSystemDDF::PlayAnimation msg;\nmsg.m_Id = animation_id;\nmsg.m_Offset = params.m_CursorStart;\nmsg.m_PlaybackRate = params.m_PlaybackRate;\n\ndmMessage::Result result = dmMessage::Post(&msg, &sender, &receiver, (uintptr_t)go, 0, 0));\n```"
  tparams {
    name: "T"
    doc: "Must be a DDF type"
    type: ""
  }
  notes: "Message data is copied by value"
  language: ""
}
elements {
  type: FUNCTION
  name: "ParseUrl"
  brief: "Convert a string to a URL struct"
  description: "Convert a string to a URL struct"
  returnvalues {
    name: "-"
    doc: "RESULT_OK on success\n- RESULT_MALFORMED_URL if the uri could not be parsed"
    types: ""
  }
  parameters {
    name: "uri"
    doc: "string of the format [socket:][path][#fragment]"
    types: "const char*"
    is_optional: false
  }
  parameters {
    name: "out"
    doc: "url in string format, must not be 0x0"
    types: "dmMessage::StringUrl"
    is_optional: false
  }
  examples: ""
  notes: "No allocation occurs, thus no cleanup is needed."
  language: ""
}
