elements {
  type: FUNCTION
  name: "dmCrypt::Base64Encode"
  brief: "Base64 encode a buffer"
  description: "Base64 encode a buffer"
  returnvalues {
    name: "success"
    doc: "true if the encoding went ok"
    types: "bool"
  }
  parameters {
    name: "src"
    doc: "The source data to encode"
    types: "const uint8_t*"
    is_optional: false
  }
  parameters {
    name: "src_len"
    doc: "key The length of source data in bytes"
    types: "uint32_t"
    is_optional: false
  }
  parameters {
    name: "dst"
    doc: "The destination buffer"
    types: "uint8_t*"
    is_optional: false
  }
  parameters {
    name: "dst_len[in,out]"
    doc: "In: The length of the destination in bytes. Out: The length of the encoded string."
    types: "uint32_t*"
    is_optional: false
  }
  examples: ""
  notes: "Call this function with *dst_len = 0 to obtain the required buffer size in *dst_len"
  notes: "An empty input (src_len = 0) still requires one byte for the terminating null, and encodes into *dst_len = 0"
  language: ""
}
elements {
  type: FUNCTION
  name: "dmCrypt::Base64Decode"
  brief: "Base64 decode a buffer"
  description: "Base64 decode a buffer"
  returnvalues {
    name: "success"
    doc: "true if the decoding went ok"
    types: "bool"
  }
  parameters {
    name: "src"
    doc: "The source data to encode"
    types: "const uint8_t*"
    is_optional: false
  }
  parameters {
    name: "src_len"
    doc: "key The length of source data in bytes"
    types: "uint32_t"
    is_optional: false
  }
  parameters {
    name: "dst"
    doc: "The destination buffer"
    types: "uint8_t*"
    is_optional: false
  }
  parameters {
    name: "dst_len[in,out]"
    doc: "In: The length of the destination in bytes. Out: The length of the decoded string."
    types: "uint32_t*"
    is_optional: false
  }
  examples: ""
  notes: "Call this function with *dst_len = 0 to obtain the required buffer size in *dst_len"
  notes: "An empty input (src_len = 0) decodes into zero bytes: the function returns true with *dst_len = 0"
  language: ""
}
