elements {
  type: MACRO
  name: "DM_ALIGNED"
  brief: "data structure alignment macro"
  description: "Data structure alignment"
  parameters {
    name: "a"
    doc: "number of bytes to align to"
    types: "int"
    is_optional: false
  }
  examples: "Align m_Data to 16 bytes alignment boundary:\n\n```cpp\nint DM_ALIGNED(16) m_Data;\n```"
  language: ""
}
elements {
  type: MACRO
  name: "DM_ALIGN"
  brief: "value alignment macro"
  description: "Align a value to a boundary"
  parameters {
    name: "x"
    doc: "value to align"
    types: "int"
    is_optional: false
  }
  parameters {
    name: "a"
    doc: "alignment boundary"
    types: "int"
    is_optional: false
  }
  examples: "Align 24 to 16 alignment boundary. results is 32:\n\n```cpp\nint result = DM_ALIGN(24, 16);\n```"
  language: ""
}
info {
  namespace: ""
  name: "Align"
  brief: "Align API documentation"
  description: "Alignment macros. Use for compiler compatibility"
  path: "engine/dlib/src/dmsdk/dlib/align.h"
  file: "dmsdk/dlib/align.h"
  language: "C"
}
