elements {
  type: FUNCTION
  name: "HttpSetRequestBody"
  brief: "set request body"
  description: "Copies request body data into the request. Passing a zero size clears the body.\nThe current HTTP client sends request bodies for POST, PUT, and PATCH."
  returnvalues {
    name: "result"
    doc: "HTTP_RESULT_OK on success."
    types: "HttpResult"
  }
  parameters {
    name: "request"
    doc: "Request object."
    types: "HttpRequest*"
    is_optional: false
  }
  parameters {
    name: "body"
    doc: "Request body data."
    types: "const void*"
    is_optional: false
  }
  parameters {
    name: "body_size"
    doc: "Request body size."
    types: "uint32_t"
    is_optional: false
  }
  examples: ""
  language: ""
}
elements {
  type: FUNCTION
  name: "HttpSetResponsePath"
  brief: "set response path"
  description: "Stores a user supplied path with the request. The HTTP API does not write the\nresponse to this path; it is returned in response callbacks for callers that\nwant to write response data themselves."
  returnvalues {
    name: "result"
    doc: "HTTP_RESULT_OK on success."
    types: "HttpResult"
  }
  parameters {
    name: "request"
    doc: "Request object."
    types: "HttpRequest*"
    is_optional: false
  }
  parameters {
    name: "path"
    doc: "Response path, or 0 to clear."
    types: "const char*"
    is_optional: false
  }
  examples: ""
  language: ""
}
