elements {
  type: FUNCTION
  name: "HttpResponseGetHeader"
  brief: "get response header"
  description: "Valid for HTTP_RESPONSE_EVENT_HEADER. Returns the raw response header line\nas \"Name:Value\", without a trailing newline. The returned pointer is valid\nonly for the duration of the callback. Use HttpResponseGetHeaderSize() for\nthe number of bytes in the header line."
  returnvalues {
    name: "header"
    doc: "Raw header line in \"Name:Value\" form."
    types: "const char*"
  }
  parameters {
    name: "response"
    doc: "Response data."
    types: "const HttpResponseInfo*"
    is_optional: false
  }
  examples: ""
  language: ""
}
