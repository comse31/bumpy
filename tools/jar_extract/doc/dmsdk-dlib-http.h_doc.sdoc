elements {
  type: FUNCTION
  name: "HttpPushRequest"
  brief: "push a request to an HTTP service"
  description: "On success, ownership of request is transferred to the service and the caller\nmust not modify or delete it."
  returnvalues {
    name: "result"
    doc: "HTTP_RESULT_OK on success."
    types: "HttpResult"
  }
  parameters {
    name: "service"
    doc: "HTTP service object."
    types: "HttpService*"
    is_optional: false
  }
  parameters {
    name: "request"
    doc: "Request object."
    types: "HttpRequest*"
    is_optional: false
  }
  parameters {
    name: "request_handle"
    doc: "Request handle on success."
    types: "HttpRequestHandle*"
    is_optional: false
  }
  examples: ""
  language: ""
}
elements {
  type: FUNCTION
  name: "HttpCancelRequest"
  brief: "request cancellation"
  description: "Marks a queued or running request as canceled. Cancellation is best effort."
  returnvalues {
    name: "result"
    doc: "HTTP_RESULT_OK on success."
    types: "HttpResult"
  }
  parameters {
    name: "service"
    doc: "HTTP service object."
    types: "HttpService*"
    is_optional: false
  }
  parameters {
    name: "request_handle"
    doc: "Request handle returned by HttpPushRequest()."
    types: "HttpRequestHandle"
    is_optional: false
  }
  examples: ""
  language: ""
}
