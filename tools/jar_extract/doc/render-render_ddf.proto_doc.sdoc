elements {
  type: MESSAGE
  name: "draw_debug_text"
  brief: "draw a text on the screen"
  description: "Draw a text on the screen. This should be used for debugging purposes only."
  parameters {
    name: "position"
    doc: "position of the text"
    types: "vector3"
    is_optional: false
  }
  parameters {
    name: "text"
    doc: "the text to draw"
    types: "string"
    is_optional: false
  }
  parameters {
    name: "color"
    doc: "color of the text"
    types: "vector4"
    is_optional: false
  }
  examples: "```lua\nmsg.post(\"@render:\", \"draw_debug_text\", { text = \"Hello world!\", position = vmath.vector3(200, 200, 0), color = vmath.vector4(1, 0, 0, 1) } )\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "draw_line"
  brief: "draw a line on the screen"
  description: "Draw a line on the screen. This should mostly be used for debugging purposes."
  parameters {
    name: "start_point"
    doc: "start point of the line"
    types: "vector3"
    is_optional: false
  }
  parameters {
    name: "end_point"
    doc: "end point of the line"
    types: "vector3"
    is_optional: false
  }
  parameters {
    name: "color"
    doc: "color of the line"
    types: "vector4"
    is_optional: false
  }
  examples: "```lua\n-- draw a white line from (200, 200) to (200, 300)\nmsg.post(\"@render:\", \"draw_line\", { start_point = vmath.vector3(200, 200, 0), end_point = vmath.vector3(200, 300, 0), color = vmath.vector4(1, 1, 1, 1) } )\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "window_resized"
  brief: "reports a window size change"
  description: "Reports a change in window size. This is initiated on window resize on desktop or by orientation changes\non mobile devices."
  parameters {
    name: "height"
    doc: "the new window height"
    types: "number"
    is_optional: false
  }
  parameters {
    name: "width"
    doc: "the new window width"
    types: "number"
    is_optional: false
  }
  examples: "```lua\nfunction on_message(self, message_id, message)\n    -- check for the message\n    if message_id == hash(\"window_resized\") then\n        -- the window was resized.\n    end\nend\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "resize"
  brief: "resizes the window"
  description: "Set the size of the game window. Only works on desktop platforms."
  parameters {
    name: "height"
    doc: "the new window height"
    types: "number"
    is_optional: false
  }
  parameters {
    name: "width"
    doc: "the new window width"
    types: "number"
    is_optional: false
  }
  examples: "```lua\nmsg.post(\"@render:\", \"resize\", { width = 1024, height = 768 } )\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "clear_color"
  brief: "set clear color"
  description: "Set render clear color. This is the color that appears on the screen where nothing is rendered, i.e. background."
  parameters {
    name: "color"
    doc: "color to use as clear color"
    types: "vector4"
    is_optional: false
  }
  examples: "```lua\nmsg.post(\"@render:\", \"clear_color\", { color = vmath.vector4(1, 0, 0, 0) } )\n```"
  language: ""
}
info {
  namespace: "render"
  name: "Render"
