elements {
  type: FUNCTION
  name: "TraverseGetRoot"
  brief: "Gets the top node of the whole game (the main coll..."
  description: "Gets the top node of the whole game (the main collection)"
  returnvalues {
    name: "result"
    doc: "True if successful"
    types: "bool"
  }
  parameters {
    name: "regist"
    doc: "the full gameobject register"
    types: "dmGameObject::HRegister"
    is_optional: false
  }
  parameters {
    name: "node"
    doc: "the node to inspect"
    types: "dmGameObject::HRegister"
    is_optional: false
  }
  examples: "The following examples show how to iterate over currently loaded scene graph\n\n```cpp\nvoid OutputNode(dmGameObject::SceneNode* node) {\n    dmGameObject::SceneNodeIterator it = dmGameObject::TraverseIterateChildren(node);\n    while(dmGameObject::TraverseIterateNext(&it))\n    {\n        OutputProperties(&it.m_Node); // see dmGameObject::TraverseIterateProperties()\n        OutputNode(&it.m_Node);\n    }\n}\n\nbool OutputScene(HRegister regist) {\n    dmGameObject::SceneNode root;\n    if (!dmGameObject::TraverseGetRoot(regist, &root))\n        return false;\n    OutputNode(&node);\n}\n```"
  notes: "The dmGameObject::HRegister is obtained from the `dmEngine::GetGameObjectRegister(dmExtension::AppParams)`"
  notes: "Traversing the scene like this is not efficient. These functions are here for inspection and testing purposes only."
  language: ""
}
