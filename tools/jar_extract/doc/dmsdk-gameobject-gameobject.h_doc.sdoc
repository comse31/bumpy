elements {
  type: FUNCTION
  name: "Spawn"
  brief: "spawn a new game object"
  description: "Spawns a new gameobject instance. The actual creation is performed after the update is completed."
  parameters {
    name: "collection"
    doc: "Gameobject collection"
    types: "HCollection"
    is_optional: false
  }
  parameters {
    name: "prototype"
    doc: "Prototype"
    types: "HPrototype"
    is_optional: false
  }
  parameters {
    name: "prototype_name"
    doc: "Prototype file name (.goc)"
    types: "const char*"
    is_optional: false
  }
  parameters {
    name: "id"
    doc: "Id of the spawned instance"
    types: "dmhash_t"
    is_optional: false
  }
  parameters {
    name: "properties"
    doc: "Container with override properties"
    types: "HPropertyContainer"
    is_optional: false
  }
  parameters {
    name: "position"
    doc: "Position of the spawed object"
    types: "dmVMath::Vector3"
    is_optional: false
  }
  parameters {
    name: "rotation"
    doc: "Rotation of the spawned object"
    types: "dmVMath::Quat"
    is_optional: false
  }
  parameters {
    name: "scale"
    doc: "Scale of the spawned object\nreturn instance [type: HInstance] the spawned instance, 0 at failure"
    types: "dmVMath::Vector3"
    is_optional: false
  }
  examples: ""
  language: ""
}
