elements {
  type: CLASS
  name: "dmHashTable"
  brief: "hashtable"
  description: "Hashtable with chaining for collision resolution, memcpy-copy semantics (POD types) and 32-bit indicies instead of pointers. (NUMA-friendly)"
  examples: ""
  tparams {
    name: "KEY"
    doc: ""
    type: ""
  }
  tparams {
    name: "T"
    doc: ""
    type: ""
  }
  notes: "The key type needs to support == and % operators"
  language: ""
}
