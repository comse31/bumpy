elements {
  type: STRUCT
  name: "sound.play_completion"
  brief: "Sound playback completion data"
  description: "Data passed to the completion callback of [ref:sound.play]. The callback\'s\n`message_id` indicates whether playback finished or was stopped manually."
  examples: ""
  members {
    name: "play_id"
    doc: "The sequential play identifier for the playback."
    type: "number"
  }
  language: ""
}
elements {
  type: STRUCT
  name: "sound.play_properties"
  brief: "Sound playback properties"
  description: "Sound playback properties"
  examples: ""
  members {
    name: "delay?"
    doc: "Delay in seconds before playback starts. The default is 0."
    type: "number"
  }
  members {
    name: "gain?"
    doc: "Gain from 0 to 1. The default is 1; this combines with the group and master gains."
    type: "number"
  }
  members {
    name: "pan?"
    doc: "Pan from -1 to 1. The default is 0; this is added to the component pan."
    type: "number"
  }
  members {
    name: "speed?"
    doc: "Playback speed from 0 to 50. The default is 1; this is multiplied by the component speed."
    type: "number"
  }
  members {
    name: "start_time?"
    doc: "Playback offset in seconds. Mutually exclusive with `start_frame`."
    type: "number"
  }
  members {
    name: "start_frame?"
    doc: "Playback offset in frames or samples. Takes precedence over `start_time`."
    type: "number"
  }
  language: ""
}
elements {
  type: STRUCT
  name: "sound.stop_properties"
  brief: "Sound stop properties"
  description: "Sound stop properties"
  examples: ""
  members {
    name: "play_id"
    doc: "Sequential playback identifier returned by [ref:sound.play]."
    type: "number"
  }
  language: ""
}
elements {
  type: PROPERTY
  name: "gain"
  brief: "[type:number] sound gain"
  description: "The gain on the sound-component. Note that gain is in linear scale,\nbetween 0 and 1."
  examples: "```lua\nfunction init(self)\n  local gain = go.get(\"#sound\", \"gain\")\n  go.set(\"#sound\", \"gain\", gain * 1.5)\nend\n```"
  language: ""
}
elements {
  type: PROPERTY
  name: "pan"
  brief: "[type:number] sound pan"
  description: "The pan on the sound-component. The valid range is from -1.0 to 1.0,\nrepresenting -45 degrees left, to +45 degrees right."
  examples: "```lua\nfunction init(self)\n  local pan = go.get(\"#sound\", \"pan\")\n  go.set(\"#sound\", \"pan\", pan * -1)\nend\n```"
  language: ""
}
elements {
  type: PROPERTY
  name: "speed"
  brief: "[type:number] sound speed"
  description: "The speed on the sound-component where 1.0 is normal speed, 0.5 is half\nspeed and 2.0 is double speed. Valid range is 0.0 to 50.0."
  examples: "```lua\nfunction init(self)\n  local speed = go.get(\"#sound\", \"speed\")\n  go.set(\"#sound\", \"speed\", speed * 0.5)\nend\n```"
  language: ""
}
elements {
  type: PROPERTY
  name: "sound"
  brief: "[type:hash] sound data"
  description: "The sound data used when playing the sound. The type of the property is hash."
  examples: "How to change the sound:\n\n```lua\nfunction init(self)\n  -- load a wav file bundled as a custom resource\n  local wav = sys.load_resource(\"foo.wav\")\n  -- get resource path to the sound component\n  local resource_path = go.get(\"#sound\", \"sound\")\n  -- update the resource with the loaded wav file\n  resource.set_sound(resource_path, wav)\n  -- play the updated sound\n  sound.play(\"#sound\")\nend\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.is_music_playing"
  brief: "check if background music is playing"
  description: "Checks if background music is playing, e.g. from iTunes.\n\n[icon:macOS][icon:windows][icon:linux][icon:html5] On non mobile platforms,\nthis function always return `false`.\n\n[icon:attention][icon:android] On Android you can only get a correct reading\nof this state if your game is not playing any sounds itself. This is a limitation\nin the Android SDK. If your game is playing any sounds, *even with a gain of zero*, this\nfunction will return `false`.\n\nThe best time to call this function is:\n\n- In the `init` function of your main collection script before any sounds are triggered\n- In a window listener callback when the window.WINDOW_EVENT_FOCUS_GAINED event is received\n\nBoth those times will give you a correct reading of the state even when your application is\nswapped out and in while playing sounds and it works equally well on Android and iOS."
  returnvalues {
    name: "playing"
    doc: "`true` if music is playing, otherwise `false`."
    types: "boolean"
  }
  examples: "If music is playing, mute \"master\":\n\n```lua\nif sound.is_music_playing() then\n    -- mute \"master\"\n    sound.set_group_gain(\"master\", 0)\nend\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.get_rms"
  brief: "get RMS value from mixer group"
  description: "Get RMS (Root Mean Square) value from mixer group. This value is the\nsquare root of the mean (average) value of the squared function of\nthe instantaneous values.\n\nFor instance: for a sinewave signal with a peak gain of -1.94 dB (0.8 linear),\nthe RMS is <code>0.8 &times; 1/sqrt(2)</code> which is about 0.566.\n\n[icon:attention] Note the returned value might be an approximation and in particular\nthe effective window might be larger than specified."
  returnvalues {
    name: "rms_l"
    doc: "RMS value for left channel"
    types: "number"
  }
  returnvalues {
    name: "rms_r"
    doc: "RMS value for right channel"
    types: "number"
  }
  parameters {
    name: "group"
    doc: "group name"
    types: "string"
    types: "hash"
    is_optional: false
  }
  parameters {
    name: "window"
    doc: "window length in seconds"
    types: "number"
    is_optional: false
  }
  examples: "Get the RMS from the \"master\" group where a mono -1.94 dB sinewave is playing:\n\n```lua\nlocal rms = sound.get_rms(\"master\", 0.1) -- throw away right channel.\nprint(rms) --> 0.56555819511414\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.get_peak"
  brief: "get peak gain value from mixer group"
  description: "Get peak value from mixer group.\n\n[icon:attention] Note that gain is in linear scale, between 0 and 1.\nTo get the dB value from the gain, use the formula `20 * log(gain)`.\nInversely, to find the linear value from a dB value, use the formula\n<code>10<sup>db/20</sup></code>.\nAlso note that the returned value might be an approximation and in particular\nthe effective window might be larger than specified."
  returnvalues {
    name: "peak_l"
    doc: "peak value for left channel"
    types: "number"
  }
  returnvalues {
    name: "peak_r"
    doc: "peak value for right channel"
    types: "number"
  }
  parameters {
    name: "group"
    doc: "group name"
    types: "string"
    types: "hash"
    is_optional: false
  }
  parameters {
    name: "window"
    doc: "window length in seconds"
    types: "number"
    is_optional: false
  }
  examples: "Get the peak gain from the \"master\" group and convert to dB for displaying:\n\n```lua\nlocal left_p, right_p = sound.get_peak(\"master\", 0.1)\nleft_p_db = 20 * log(left_p)\nright_p_db = 20 * log(right_p)\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.set_group_gain"
  brief: "set mixer group gain"
  description: "Set mixer group gain"
  parameters {
    name: "group"
    doc: "group name"
    types: "string"
    types: "hash"
    is_optional: false
  }
  parameters {
    name: "gain"
    doc: "gain in range [0..1] mapped to [0 .. -60dB]"
    types: "number"
    is_optional: false
  }
  examples: "Set mixer group gain on the \"soundfx\" group to 50% (-30dB):\n\n```lua\nsound.set_group_gain(\"soundfx\", 0.5)\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.get_group_gain"
  brief: "get mixer group gain"
  description: "Get mixer group gain"
  returnvalues {
    name: "gain"
    doc: "gain in [0 1] range ([-60dB.. 0dB])"
    types: "number"
  }
  parameters {
    name: "group"
    doc: "group name"
    types: "string"
    types: "hash"
    is_optional: false
  }
  examples: "Get the mixer group gain for the \"soundfx\" and convert to dB:\n\n```lua\nlocal gain = sound.get_group_gain(\"soundfx\")\nlocal gain_db = 60 * gain\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.get_groups"
  brief: "get all mixer group names"
  description: "Get a table of all mixer group names (hashes)."
  returnvalues {
    name: "groups"
    doc: "table of mixer group names"
    types: "hash[]"
  }
  examples: "Get the mixer groups, set all gains to 0 except for \"master\" and \"soundfx\"\nwhere gain is set to 1:\n\n```lua\nlocal groups = sound.get_groups()\nfor _,group in ipairs(groups) do\n    if group == hash(\"master\") or group == hash(\"soundfx\") then\n        sound.set_group_gain(group, 1)\n    else\n        sound.set_group_gain(group, 0)\n    end\nend\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.get_group_name"
  brief: "get mixer group name string"
  description: "Get a mixer group name as a string.\n\n[icon:attention] This function is to be used for debugging and\ndevelopment tooling only. The function does a reverse hash lookup, which does not\nreturn a proper string value when the game is built in release mode."
  returnvalues {
    name: "name"
    doc: "group name"
    types: "string"
  }
  parameters {
    name: "group"
    doc: "group name"
    types: "string"
    types: "hash"
    is_optional: false
  }
  examples: "Get the mixer group string names so we can show them as labels on a dev mixer overlay:\n\n```lua\nlocal groups = sound.get_groups()\nfor _,group in ipairs(groups) do\n    local name = sound.get_group_name(group)\n    msg.post(\"/mixer_overlay#gui\", \"set_mixer_label\", { group = group, label = name})\nend\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.is_phone_call_active"
  brief: "check if a phone call is active"
  description: "Checks if a phone call is active. If there is an active phone call all\nother sounds will be muted until the phone call is finished.\n\n[icon:macOS][icon:windows][icon:linux][icon:html5] On non mobile platforms,\nthis function always return `false`."
  returnvalues {
    name: "call_active"
    doc: "`true` if there is an active phone call, `false` otherwise."
    types: "boolean"
  }
  examples: "Test if a phone call is on-going:\n\n```lua\nif sound.is_phone_call_active() then\n    -- do something sensible.\nend\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.play"
  brief: "plays a sound"
  description: "Make the sound component play its sound. Multiple voices are supported. The limit is set to 32 voices per sound component.\n\n[icon:attention] A sound will continue to play even if the game object the sound component belonged to is deleted. You can call `sound.stop()` to stop the sound."
  returnvalues {
    name: "play_id"
    doc: "The identifier for the sound voice"
    types: "number"
  }
  parameters {
    name: "url"
    doc: "the sound that should play"
    types: "string"
    types: "hash"
    types: "url"
    is_optional: false
  }
  parameters {
    name: "play_properties"
    doc: "optional playback properties"
    types: "sound.play_properties"
    is_optional: true
  }
  parameters {
    name: "complete_function"
    doc: "function to call when the sound has finished playing or stopped manually via [ref:sound.stop].\n\n`self`\n: [type:script_instance] The current script instance.\n\n`message_id`\n: [type:hash] The name of the completion message, which can be either `\"sound_done\"` if the sound has finished playing, or `\"sound_stopped\"` if it was stopped manually.\n\n`message`\n: [type:sound.play_completion] Information about the completed or stopped playback.\n\n`sender`\n: [type:url] The invoker of the callback: the sound component."
    types: "fun(self:script_instance, message_id:hash, message:sound.play_completion, sender:url)"
    is_optional: true
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will make the component play its sound after 1 second:\n\n```lua\nsound.play(\"#sound\", { delay = 1, gain = 0.9, pan = -1.0 } )\n```\n\nUsing the callback argument, you can chain several sounds together:\n\n```lua\nlocal function sound_done(self, message_id, message, sender)\n  -- play \'boom\' sound fx when the countdown has completed\n  if message_id == hash(\"sound_done\") and message.play_id == self.countdown_id then\n    sound.play(\"#boom\", nil, sound_done)\n  end\nend\n\nfunction init(self)\n  self.countdown_id = sound.play(\"#countdown\", nil, sound_done)\nend\n```"
  notes: "Sounds are panned using a constant power panning (non linear fade). 0 means left/right channels are balanced at 71%/71% each.\nAt -1 (full left) the channels are at 100%/0%, and 1 they\'re at 0%/100%."
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.stop"
  brief: "stop a playing a sound(s)"
  description: "Stop playing all active voices or just one voice if `play_id` provided"
  parameters {
    name: "url"
    doc: "the sound component that should stop"
    types: "string"
    types: "hash"
    types: "url"
    is_optional: false
  }
  parameters {
    name: "stop_properties"
    doc: "optional playback to stop"
    types: "sound.stop_properties"
    is_optional: true
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will make the component stop all playing voices:\n\n```lua\nsound.stop(\"#sound\")\nlocal id = sound.play(\"#sound\")\nsound.stop(\"#sound\", {play_id = id})\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.pause"
  brief: "pause a playing a sound(s)"
  description: "Pause all active voices"
  parameters {
    name: "url"
    doc: "the sound that should pause"
    types: "string"
    types: "hash"
    types: "url"
    is_optional: false
  }
  parameters {
    name: "pause"
    doc: "true if the sound should pause"
    types: "boolean"
    is_optional: false
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will make the component pause all playing voices:\n\n```lua\nsound.pause(\"#sound\", true)\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.set_gain"
  brief: "set sound gain"
  description: "Set gain on all active playing voices of a sound."
  parameters {
    name: "url"
    doc: "the sound to set the gain of"
    types: "string"
    types: "hash"
    types: "url"
    is_optional: false
  }
  parameters {
    name: "gain"
    doc: "sound gain between 0 and 1 [-60dB .. 0dB]. The final gain of the sound will be a combination of this gain, the group gain and the master gain."
    types: "number"
    is_optional: true
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will set the gain to 0.9\n\n```lua\nsound.set_gain(\"#sound\", 0.9)\n```"
  language: ""
}
elements {
  type: FUNCTION
  name: "sound.set_pan"
  brief: "set sound pan"
  description: "Set panning on all active playing voices of a sound.\n\nThe valid range is from -1.0 to 1.0, representing -45 degrees left, to +45 degrees right."
  parameters {
    name: "url"
    doc: "the sound to set the panning value to"
    types: "string"
    types: "hash"
    types: "url"
    is_optional: false
  }
  parameters {
    name: "pan"
    doc: "sound panning between -1.0 and 1.0"
    types: "number"
    is_optional: true
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will set the gain to 0.5\n\n```lua\nsound.set_pan(\"#sound\", 0.5) -- pan to the right\n```"
  notes: "Sounds are panned using a constant power panning (non linear fade). 0 means left/right channels are balanced at 71%/71% each.\nAt -1 (full left) the channels are at 100%/0%, and 1 they\'re at 0%/100%."
  language: ""
}
elements {
  type: MESSAGE
  name: "play_sound"
  brief: "plays a sound"
  description: "Post this message to a sound-component to make it play its sound. Multiple voices is supported. The limit is set to 32 voices per sound component.\n\n[icon:attention] Note that gain is in linear scale, between 0 and 1.\nTo get the dB value from the gain, use the formula `20 * log(gain)`.\nInversely, to find the linear value from a dB value, use the formula\n<code>10<sup>db/20</sup></code>.\n\n[icon:attention] A sound will continue to play even if the game object the sound component belonged to is deleted. You can send a `stop_sound` to stop the sound.\n\n[icon:attention] `play_id` should be specified in case you want to receive `sound_done` or `sound_stopped` in `on_message()`."
  parameters {
    name: "delay"
    doc: "delay in seconds before the sound starts playing, default is 0."
    types: "number"
    is_optional: true
  }
  parameters {
    name: "gain"
    doc: "sound gain between 0 and 1, default is 1."
    types: "number"
    is_optional: true
  }
  parameters {
    name: "play_id"
    doc: "the identifier of the sound, can be used to distinguish between consecutive plays from the same component."
    types: "number"
    is_optional: true
  }
  parameters {
    name: "start_time"
    doc: "optional start offset (seconds). Mutually exclusive with `start_frame`."
    types: "number"
    is_optional: true
  }
  parameters {
    name: "start_frame"
    doc: "optional start offset (frames). If both are provided, `start_frame` is used."
    types: "number"
    is_optional: true
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will make the component play its sound after 1 second:\n\n```lua\nmsg.post(\"#sound\", \"play_sound\", {delay = 1, gain = 0.5})\n```\n\n```lua\n-- use `play_id` and `msg.post()` if you want to recieve `sound_done` or `sound_stopped` in on_message()\nfunction init()\n msg.post(\"#sound\", \"play_sound\", {play_id = 1, delay = 1, gain = 0.5})\nend\n\nfunction on_message(self, message_id, message)\n if message_id == hash(\"sound_done\") then\n     print(\"Sound play id: \"..message.play_id)\n end\nend\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "stop_sound"
  brief: "stop a playing a sound(s)"
  description: "Post this message to a sound-component to make it stop playing all active voices"
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will make the component stop all playing voices:\n\n```lua\nmsg.post(\"#sound\", \"stop_sound\")\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "set_gain"
  brief: "set sound gain"
  description: "Post this message to a sound-component to set gain on all active playing voices.\n\n[icon:attention] Note that gain is in linear scale, between 0 and 1.\nTo get the dB value from the gain, use the formula `20 * log(gain)`.\nInversely, to find the linear value from a dB value, use the formula\n<code>10<sup>db/20</sup></code>."
  parameters {
    name: "gain"
    doc: "sound gain between 0 and 1, default is 1."
    types: "number"
    is_optional: true
  }
  examples: "Assuming the script belongs to an instance with a sound-component with id \"sound\", this will set the gain to 0.5\n\n```lua\nmsg.post(\"#sound\", \"set_gain\", {gain = 0.5})\n```"
  language: ""
}
elements {
  type: MESSAGE
  name: "sound_done"
  brief: "reports when a sound has finished playing"
  description: "This message is sent back to the sender of a `play_sound` message\nif the sound could be played to completion and a `play_id` was provided with the `play_sound` message."
  parameters {
    name: "play_id"
    doc: "id number supplied when the message was posted."
    types: "number"
    is_optional: true
  }
  examples: ""
  language: ""
}
elements {
  type: MESSAGE
  name: "sound_stopped"
  brief: "reports when a sound has been manually stopped"
  description: "This message is sent back to the sender of a `play_sound` message, if the sound\nhas been manually stopped and a `play_id` was provided with the `play_sound` message."
  parameters {
    name: "play_id"
    doc: "id number supplied when the message was posted."
    types: "number"
    is_optional: true
  }
  examples: ""
  language: ""
}
info {
  namespace: "sound"
  name: "Sound"
  brief: "Sound API documentation"
  description: "Functions and messages for controlling sound components and\nmixer groups."
  path: "engine/gamesys/src/gamesys/scripts/script_sound.cpp"
  file: ""
  language: "Lua"
}
