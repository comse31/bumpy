[Unit]
Description=Bumpy: часовой запуск генератора уровней

[Timer]
# Ровно раз в час: в 5 минут каждого часа (не на границе часа, чтобы не
# пересекаться с другими задачами).
OnCalendar=*-*-* *:05:00
# Если машина была выключена — догнать пропущенный запуск один раз.
Persistent=true
# Разброс не нужен: на сервере один генератор.
AccuracySec=1min
Unit=bumpy-gen.service

[Install]
WantedBy=timers.target
