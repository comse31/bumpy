name: "main"
# Уровень не прописан статически: его генерирует level.script из метаданных
# (main/levels.json). Здесь остаются только загрузчик уровня, шар и HUD-карман.
# --- пропорции поля: переключает рендер на fixed-fit проекцию (см. projection.script),
# чтобы при любом размере окна игровое поле масштабировалось без искажения
instances {
  id: "projection"
  prototype: "/main/render/projection.go"
}
instances {
  id: "level"
  prototype: "/main/level/level.go"
}
instances {
  id: "ball_visual"
  prototype: "/main/ball/ball_visual.go"
  position {
    x: 80.0
    y: 579.33
  }
  scale3 {
    x: 0.0625
    y: 0.0625
    z: 0.0625
  }
}
