# --- GAME OVER: плашка по центру поля, поверх всех объектов (z ближе к камере) ---
instances {
  id: "game_over"
  prototype: "/main/ui/game_over.go"
  position {
    x: 480.0
    y: 320.0
    z: 0.9
  }
}
# --- READY FOR LEVEL N?: плашка перед началом уровня, поверх всех объектов ---
instances {
  id: "ready"
  prototype: "/main/ui/ready.go"
  position {
    x: 480.0
    y: 320.0
    z: 0.95
  }
}
# --- YOU LOCK IN TRAP: плашка ловушки с обратным отсчётом, поверх всех объектов ---
