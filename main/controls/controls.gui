# Круглая кнопка «назад»: слева от предметов в полосе кармана. Нажатие
# возвращает игрока в стартовое меню (см. main/controls/controls.gui_script и
# main/pocket/pocket_layout.lua — геометрия полосы общая с карманом).
# Позиция и размер здесь — только стартовые (центр полосы на y = 680, слева,
# диаметр 40): дальше их каждый кадр пересчитывает скрипт под текущий трансформ
# полосы кармана. adjust_mode STRETCH, а не FIT: скрипт задаёт размеры по X и Y
# раздельно, чтобы кнопка осталась круглой при любом соотношении сторон экрана.
nodes {
  position {
    x: 60.0
    y: 680.0
    z: 0.1
    w: 1.0
  }
  size {
    x: 40.0
    y: 40.0
    z: 0.0
    w: 1.0
  }
  color {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
  type: TYPE_BOX
  blend_mode: BLEND_MODE_ALPHA
  texture: "controls/btn_left"
  id: "back"
  pivot: PIVOT_CENTER
  adjust_mode: ADJUST_MODE_STRETCH
  inherit_alpha: true
  alpha: 0.92
  clipping_mode: CLIPPING_MODE_NONE
  clipping_visible: true
  clipping_inverted: false
}

material: "/builtins/materials/gui.material"
adjust_reference: ADJUST_REFERENCE_PARENT
max_nodes: 17
