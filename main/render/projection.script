-- Сохранение пропорций игрового поля при изменении размеров окна.
-- Стандартный рендер-скрипт Defold (/builtins/render/default.render_script)
-- использует stretch-проекцию: поле растягивается на всё окно, и при
-- нестандартном соотношении сторон пропорции клеток и объектов искажаются.
-- Сообщаем рендер-скрипту переключиться на fixed-fit проекцию: игровое поле
-- целиком помещается в окно и масштабируется РАВНОМЕРНО по обеим осям
-- (при необходимости по краям появляются поля). Проекция хранится в
-- рендер-скрипте, поэтому одного сообщения достаточно — при последующих
-- изменениях размера окна она пересчитывается уже по fixed-fit.
local NEAR = -1
local FAR = 1

local function use_fit_projection()
    msg.post("@render:", "use_fixed_fit_projection", { near = NEAR, far = FAR })
end

function init(self)
    use_fit_projection()
end
