-- Стартовое меню: выбор режима и правка имени игрока.
--
-- Показывается после загрузки игры, после GAME OVER (см. ball_progress.lua) и
-- после прохождения уровня в режиме «Приключение».
-- Пока меню открыто, игра на паузе: game_mode.is_menu_open() == true, мяч
-- заморожен, ввод получает меню, а не мяч.
--
-- Пункты:
--   1. Classic game — основная игра с жизнями (game_mode.CLASSIC);
--   2. Adventure    — подменю выбора любого открытого уровня
--      (1..максимальный, достигнутый в классическом режиме), игра на нём
--      с фиксированным набором: 3 жизни и по 5 капель/ключей/молотков.
--      После прохождения уровня игра возвращается в это меню.
--
-- Приветствия нет: сверху только заголовок BUMPY. Имя игрока показывается
-- в строке «Name: ...» и его можно изменить (клавиша F2 или тап по строке):
-- ввод идёт через text-триггер (input/game.input_binding), Enter сохраняет,
-- Esc/повторный F2 — отмена, Backspace стирает последний символ.
-- Имя запоминается между сессиями.
--
-- Надписи задаются из скрипта, а не статикой в .gui: так текст легко менять без
-- правки ресурсов. Шрифт Banty Bold содержит только латиницу, поэтому вся
-- текстовая часть интерфейса — на английском.
local profile = require("main.player_profile")
local mode = require("main.game_mode")
-- прогресс классической игры: текущий и максимально достигнутый уровень
local save = require("main.save")

-- узлы главного экрана (main/ui/menu/menu.gui)
local MAIN_NODES = {
    "title",
    "btn_classic",
    "btn_classic_label",
    "btn_adventure",
    "btn_adventure_label",
    "name_box",
    "name_hint",
    "edit_hint",
}

-- узлы подменю выбора уровня «Приключения»
local ADV_NODES = {
    "adv_title",
    "adv_level",
    "adv_prev",
    "adv_prev_label",
    "adv_next",
    "adv_next_label",
    "adv_play",
    "adv_play_label",
    "adv_back",
    "adv_back_label",
}

local LABEL_CLASSIC = "Classic game"
local LABEL_ADVENTURE = "Adventure"
local HINT_EDIT = "F2 or tap the name to change"
local HINT_SAVE = "Enter - save, Backspace - erase, Esc - cancel"
local NAME_PREFIX = "Name: "

local ADV_TITLE = "Choose level"
local ADV_PLAY = "Play level"
local ADV_BACK = "Back"
local ADV_PREV = "<"
local ADV_NEXT = ">"

-- допустимые символы имени: латиница, цифры, пробел, дефис и подчёркивание
local function sanitize_char(ch)
    if not ch or ch == "" then
        return nil
    end
    if ch:match("^%s$") then
        return " "
    end
    if ch:match("^[%w%-_%.]$") then
        return ch
    end
    return nil
end

-- включить/выключить узлы экрана (main или adventure) и сам видимый слой
local function apply_screen(self)
    gui.set_enabled(self.nodes.backdrop, self.visible)
    local main_on = self.visible and self.screen == "main"
    local adv_on = self.visible and self.screen == "adventure"
    for _, id in ipairs(MAIN_NODES) do
        gui.set_enabled(self.nodes[id], main_on)
    end
    for _, id in ipairs(ADV_NODES) do
        gui.set_enabled(self.nodes[id], adv_on)
    end
end

local function set_visible(self, visible)
    self.visible = visible and true or false
    if not self.visible then
        if self.editing and gui.hide_keyboard then
            pcall(gui.hide_keyboard)
        end
        self.editing = false
    end
    apply_screen(self)
    if self.visible then
        msg.post(".", "acquire_input_focus")
    end
    -- ВАЖНО: фокус ввода НЕ отпускаем. GUI-скрипт меню продолжает получать
    -- ввод, но при visible == false сразу возвращает false — событие идёт
    -- дальше по стеку ввода к мячу. Отпускание фокуса ломало порядок стека:
    -- после него события до /ball уже не доходили (не снималась плашка READY).
end

-- Подпись классического пункта: к названию добавляется текущий и максимально
-- достигнутый уровень.
local function classic_label()
    local level, max_level = save.progress()
    return string.format("%s   lvl %d (max %d)", LABEL_CLASSIC, level, max_level)
end

-- Подпись пункта «Приключение»: подсказка о доступном диапазоне уровней.
local function adventure_label()
    local _, max_level = save.progress()
    return string.format("%s  (max %d)", LABEL_ADVENTURE, math.max(1, max_level))
end

-- текст строки имени с учётом режима правки (приветствия в меню нет)
local function refresh(self)
    local shown = self.editing and (self.buffer .. "|") or self.name
    gui.set_text(self.nodes.name_hint, NAME_PREFIX .. shown)
    gui.set_text(self.nodes.btn_classic_label, classic_label())
    gui.set_text(self.nodes.btn_adventure_label, adventure_label())
    gui.set_text(self.nodes.edit_hint, self.editing and HINT_SAVE or HINT_EDIT)
end

-- Пересчитать границы допустимых уровней для «Приключения»: доступны уровни
-- 1..max_level, где max_level — рекорд классического режима (только растёт).
-- Выбранный уровень зажимается в этот диапазон.
local function refresh_adventure(self)
    local _, max_level = save.progress()
    self.adv_max = math.max(1, max_level)
    self.adv_level = math.max(1, math.min(self.adv_max, self.adv_level or 1))
    gui.set_text(self.nodes.adv_title, ADV_TITLE)
    gui.set_text(self.nodes.adv_level, string.format("Level %d  (max %d)", self.adv_level, self.adv_max))
    gui.set_text(self.nodes.adv_prev_label, ADV_PREV)
    gui.set_text(self.nodes.adv_next_label, ADV_NEXT)
    gui.set_text(self.nodes.adv_play_label, string.format("%s %d", ADV_PLAY, self.adv_level))
    gui.set_text(self.nodes.adv_back_label, ADV_BACK)
end

local function begin_edit(self)
    if self.editing then
        return
    end
    self.editing = true
    self.buffer = self.name
    if gui.show_keyboard then
        pcall(gui.show_keyboard, gui.KEYBOARD_TYPE_DEFAULT, true)
    end
    refresh(self)
end

local function end_edit(self, save_name)
    if not self.editing then
        return
    end
    self.editing = false
    if save_name then
        local saved = profile.set_name(self.buffer)
        self.name = saved or self.name
    end
    if gui.hide_keyboard then
        pcall(gui.hide_keyboard)
    end
    refresh(self)
end

-- открыть меню (старт игры, GAME OVER или конец уровня в «Приключении»):
-- игра ставится на паузу, сенсорное управление сбрасывает удержания,
-- приветствие обновляется из профиля, показывается главный экран
local function open_menu(self)
    mode.set_menu_open(true)
    msg.post("/controls", "reset")
    self.name = profile.get_name()
    if self.editing and gui.hide_keyboard then
        pcall(gui.hide_keyboard)
    end
    self.editing = false
    self.screen = "main"
    refresh(self)
    refresh_adventure(self)
    set_visible(self, true)
end

-- перейти к подменю выбора уровня «Приключения»
local function open_adventure(self)
    end_edit(self, true)
    self.screen = "adventure"
    -- по умолчанию предлагаем последний выбранный уровень, но не выше рекорда
    self.adv_level = mode.get_adventure_level()
    refresh_adventure(self)
    apply_screen(self)
end

-- вернуться с подменю на главный экран
local function back_to_main(self)
    self.screen = "main"
    refresh(self)
    apply_screen(self)
end

-- сменить выбранный уровень «Приключения» на delta (±1) с зажимом в 1..max
local function change_level(self, delta)
    local next_level = (self.adv_level or 1) + (delta or 0)
    self.adv_level = math.max(1, math.min(self.adv_max or 1, next_level))
    refresh_adventure(self)
end

-- запуск выбранного режима: меню закрывается, мяч получает сообщение
local function start_mode(self, chosen)
    end_edit(self, true)
    mode.set_mode(chosen)
    if chosen == mode.ADVENTURE then
        -- уровень выбирает игрок, границы уже зажаты в 1..adv_max
        mode.set_adventure_level(self.adv_level or 1)
    end
    mode.set_menu_open(false)
    set_visible(self, false)
    -- мячу гарантированно нужен фокус ввода: он мог быть снят при открытии
    -- меню, а без фокуса не снимается плашка READY и не работает управление
    msg.post("/ball", "acquire_input_focus")
    msg.post("/ball", "start_game", { mode = chosen })
    print("menu: start mode " .. tostring(chosen))
end

-- тап/клик по меню: кнопки режимов, подменю уровней и строка имени. Вызывается
-- и для touch (тачскрин), и для click (мышь) — в Defold это разные действия,
-- потому что touch- и mouse-триггеры не могут делить одно имя действия
local function handle_pointer(self, x, y)
    if not x or not y then
        return
    end
    if self.screen == "adventure" then
        if gui.pick_node(self.nodes.adv_prev, x, y) then
            change_level(self, -1)
        elseif gui.pick_node(self.nodes.adv_next, x, y) then
            change_level(self, 1)
        elseif gui.pick_node(self.nodes.adv_play, x, y) then
            start_mode(self, mode.ADVENTURE)
        elseif gui.pick_node(self.nodes.adv_back, x, y) then
            back_to_main(self)
        end
        return
    end
    if gui.pick_node(self.nodes.btn_classic, x, y) then
        start_mode(self, mode.CLASSIC)
    elseif gui.pick_node(self.nodes.btn_adventure, x, y) then
        open_adventure(self)
    elseif gui.pick_node(self.nodes.name_box, x, y) then
        if self.editing then
            end_edit(self, true)
        else
            begin_edit(self)
        end
    elseif self.editing then
        -- тап мимо поля имени завершает правку (сохраняя введённое)
        end_edit(self, true)
    end
end

-- добавить в буфер каждый допустимый символ из строки text
local function append_text(self, text)
    if not self.editing or type(text) ~= "string" then
        return
    end
    local changed = false
    for i = 1, #text do
        local piece = sanitize_char(text:sub(i, i))
        if piece then
            self.buffer = self.buffer .. piece
            changed = true
        end
    end
    if changed then
        self.buffer = profile.utf8_truncate(self.buffer, 16)
        refresh(self)
    end
end

local function backspace(self)
    if not self.editing then
        return
    end
    self.buffer = profile.utf8_remove_last(self.buffer)
    refresh(self)
end

function init(self)
    self.nodes = {}
    for _, id in ipairs(MAIN_NODES) do
        self.nodes[id] = gui.get_node(id)
    end
    for _, id in ipairs(ADV_NODES) do
        self.nodes[id] = gui.get_node(id)
    end
    self.nodes.backdrop = gui.get_node("backdrop")
    self.editing = false
    self.buffer = ""
    self.screen = "main"
    self.adv_level = 1
    self.adv_max = 1
    -- имя из профиля (по умолчанию «PlayerN», N — номер визита);
    -- profile.init увеличивает счётчик визитов один раз за запуск игры
    self.name = profile.init()
    -- меню появляется сразу после загрузки игры: игра стоит на паузе до
    -- выбора пункта (game_mode.is_menu_open)
    open_menu(self)
end

function final(self)
    if self.editing and gui.hide_keyboard then
        pcall(gui.hide_keyboard)
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open") then
        -- меню открывается после GAME OVER, завершения уровня в «Приключении»
        -- или по запросу: игра на паузе, показываем главный экран
        open_menu(self)
    elseif message_id == hash("hide") then
        set_visible(self, false)
    end
end

function on_input(self, action_id, action)
    if not self.visible then
        return false
    end

    -- подменю «Приключения»: стрелки/Enter/Esc и цифры управляют выбором
    if self.screen == "adventure" then
        if action_id == hash("left") then
            if action and action.pressed then
                change_level(self, -1)
            end
            return true
        elseif action_id == hash("right") then
            if action and action.pressed then
                change_level(self, 1)
            end
            return true
        elseif action_id == hash("name_enter") then
            if action and action.pressed then
                start_mode(self, mode.ADVENTURE)
            end
            return true
        elseif action_id == hash("name_cancel") then
            if action and action.pressed then
                back_to_main(self)
            end
            return true
        elseif action_id == hash("text") then
            -- печатные клавиши в подменю не нужны (и не должны попадать в игру)
            return true
        end
        if action and action.pressed and action.x ~= nil and action.y ~= nil then
            handle_pointer(self, action.x, action.y)
            return true
        end
        return true
    end

    -- ввод текста имени (text-триггер из game.input_binding)
    if action_id == hash("text") then
        local typed = action and action.text
        -- вне режима правки цифры 1/2 выбирают режим: text-триггер перехватывает
        -- все печатные клавиши раньше key-триггеров, поэтому отдельные
        -- key_trigger для цифр до меню не доходят
        if not self.editing and typed == "1" then
            start_mode(self, mode.CLASSIC)
            return true
        elseif not self.editing and typed == "2" then
            open_adventure(self)
            return true
        end
        append_text(self, typed)
        return true
    end

    if action_id == hash("edit_name") then
        if action and action.pressed then
            if self.editing then
                end_edit(self, true)
            else
                begin_edit(self)
            end
        end
        return true
    end

    if action_id == hash("name_backspace") then
        if action and action.pressed then
            backspace(self)
        end
        return true
    end

    if action_id == hash("name_enter") then
        if action and action.pressed then
            end_edit(self, true)
        end
        return true
    end

    if action_id == hash("name_cancel") then
        if action and action.pressed then
            end_edit(self, false)
        end
        return true
    end

    -- тап/клик по меню: кнопки режимов и строка имени. "touch" — тачскрин,
    -- "click" — левая кнопка мыши (в Defold это разные действия с разными
    -- именами). Координаты берём у любого нажатия с x/y, чтобы меню работало
    -- и на платформах, где указатель приходит под иным именем действия.
    if action and action.pressed and action.x ~= nil and action.y ~= nil then
        handle_pointer(self, action.x, action.y)
        return true
    end

    -- пока меню открыто, остальной ввод игре не передаём
    return true
end
