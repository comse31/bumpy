-- v10 clip preview (25 clips). Shift + keys, Z zoom, Shift+Esc hide.
local CLIPS = require("main.bumpy_v10.bumpy_v10_clips")

local CLIP_MAP = {}
for _, clip in ipairs(CLIPS) do
    CLIP_MAP[clip.name] = clip
end

local BASE_X = 480.0
local BASE_Y = 300.0
local K_REAL = 42.0 / 72.0

local KEY_CLIPS = {
    [hash("v5_preview_1")] = "beat_up",
    [hash("v5_preview_2")] = "beat_up_blink",
    [hash("v5_preview_3")] = "jump_head",
    [hash("v5_preview_4")] = "hop_flip",
    [hash("v5_preview_5")] = "second_jump",
    [hash("v5_preview_6")] = "jump_head_blink",
    [hash("v5_preview_7")] = "hop_flip_blink",
    [hash("v5_preview_8")] = "second_jump_blink",
    [hash("v5_preview_9")] = "landing",
    [hash("v5_preview_0")] = "land_head",
    [hash("v5_preview_q")] = "idle",
    [hash("v5_preview_w")] = "turn_rl",
    [hash("v5_preview_e")] = "blink",
    [hash("v5_preview_r")] = "high_jump",
    [hash("v5_preview_t")] = "fall",
    [hash("v5_preview_y")] = "head_hit_top",
    [hash("v5_preview_u")] = "feet_hit_top",
    [hash("v5_preview_i")] = "head_hit_side",
    [hash("v5_preview_o")] = "feet_hit_side",
    [hash("v5_preview_p")] = "body_hit_side",
    [hash("v5_preview_a")] = "body_hit_side_inv",
    [hash("v5_preview_s")] = "hurt",
    [hash("v5_preview_d")] = "death",
    [hash("v5_preview_f")] = "win",
    [hash("v5_preview_g")] = "collect",
}

local ACTION_ZOOM = hash("preview_z")
local ACTION_HIDE = hash("v5_preview_hide")
local ACTION_SHIFT = hash("preview_shift")

local function set_transform(self)
    local k = K_REAL * self.zoom
    go.set("#sprite", "scale", vmath.vector3(k, k, 1.0))
    go.set_position(vmath.vector3(BASE_X, BASE_Y, 0.5))
end

local function update_label(self)
    local clip = self.clip
    if not clip then
        return
    end
    local mode = clip.loop and "loop" or "once"
    local state = self.done and "DONE" or "PLAY"
    local text = string.format(
        "%s  %d fps  %s  frame %02d/%02d  zoom x%d  %s\nZ - zoom, Shift+Esc - hide",
        clip.name, clip.fps, mode, self.frame, clip.frames, self.zoom, state)
    go.set("#label", "text", text)
end

local function show(self)
    if self.hidden then
        self.hidden = false
        msg.post("#sprite", "enable")
        go.set("#label", "color", vmath.vector4(1, 1, 1, 1))
    end
end

local function hide(self)
    self.hidden = true
    msg.post("#sprite", "disable")
    go.set("#label", "color", vmath.vector4(1, 1, 1, 0))
end

local function play_clip(self, name)
    local clip = CLIP_MAP[name]
    if not clip then
        return
    end
    show(self)
    self.clip = clip
    self.time = 0.0
    self.frame = 1
    self.done = false
    msg.post("#sprite", "play_animation", { id = hash(name) })
    go.set("#sprite", "playback_rate", clip.fps / 30.0)
    update_label(self)
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.hidden = true
    self.zoom = 1
    self.shift = false
    self.clip = nil
    self.time = 0.0
    self.frame = 1
    self.done = false
    msg.post("#sprite", "disable")
    go.set("#label", "color", vmath.vector4(1, 1, 1, 0))
    set_transform(self)
end

function update(self, dt)
    if self.hidden or not self.clip then
        return
    end
    local clip = self.clip
    local duration = clip.frames / clip.fps
    self.time = self.time + dt
    if clip.loop then
        self.time = self.time % duration
        self.frame = math.floor(self.time * clip.fps) + 1
        if self.frame > clip.frames then
            self.frame = 1
        end
    elseif self.time >= duration then
        self.time = duration
        self.frame = clip.frames
        self.done = true
    else
        self.frame = math.min(clip.frames, math.floor(self.time * clip.fps) + 1)
    end
    update_label(self)
end

function on_input(self, action_id, action)
    if action_id == ACTION_SHIFT then
        self.shift = action.pressed
        return false
    end
    if action_id == ACTION_ZOOM and action.pressed then
        self.zoom = self.zoom == 1 and 4 or 1
        set_transform(self)
        update_label(self)
        return true
    end
    if not self.shift then
        return false
    end
    if action_id == ACTION_HIDE and action.pressed then
        hide(self)
        return true
    end
    local name = KEY_CLIPS[action_id]
    if name and action.pressed then
        play_clip(self, name)
        return true
    end
    return false
end
