local SIZE = 64.0
local BPM = 80.0

local PERIOD = 60.0 / BPM
local HEIGHT = 2.0 * SIZE
local GRAVITY = 8.0 * HEIGHT / (PERIOD * PERIOD)
local JUMP_SPEED = GRAVITY * PERIOD * 0.5

local SQUASH_DURATION = 0.15
local SQUASH_AMOUNT = 0.25

local STEP = 2.0 * SIZE
local MOVE_DURATION = 0.25
local MOVE_HEIGHT = SIZE
local TILT_ANGLE = math.rad(20.0)
local TILT_DURATION = 0.25

local function apply_squash(self)
    local sx = 1.0 + SQUASH_AMOUNT * self.squash
    local sy = 1.0 - SQUASH_AMOUNT * self.squash
    go.set(self.visual, "scale", vmath.vector3(sx, sy, 1.0))
end

local function apply_tilt(self)
    local a = self.tilt * (self.tilt_t / TILT_DURATION)
    go.set(self.visual, "rotation", vmath.quat_rotation_z(a))
end

local function move(self, direction)
    local position = go.get_position()
    self.move_from = position.x
    self.move_to = position.x + direction * STEP
    self.move_t = MOVE_DURATION
    self.arc_prev = 0.0
    self.tilt = -direction * TILT_ANGLE
    self.tilt_t = TILT_DURATION
end

function init(self)
    msg.post(".", "acquire_input_focus")
    physics.set_gravity(vmath.vector3(0.0, -GRAVITY, 0.0))
    self.squash = 0.0
    self.move_t = 0.0
    self.arc_prev = 0.0
    self.tilt = 0.0
    self.tilt_t = 0.0
    self.visual = go.get_id("ball_visual")
    go.set_parent(self.visual, go.get_id(), true)
end

function update(self, dt)
    if self.move_t > 0.0 then
        self.move_t = math.max(0.0, self.move_t - dt)
        local k = 1.0 - self.move_t / MOVE_DURATION
        local x = self.move_from + (self.move_to - self.move_from) * k
        local arc = MOVE_HEIGHT * (1.0 - (2.0 * k - 1.0) * (2.0 * k - 1.0))
        local position = go.get_position()
        go.set_position(vmath.vector3(x, position.y - self.arc_prev + arc, position.z))
        self.arc_prev = arc
        if self.move_t == 0.0 then
            local velocity = go.get("#collision_object", "linear_velocity")
            go.set("#collision_object", "linear_velocity", vmath.vector3(0.0, velocity.y, 0.0))
        end
    else
        self.arc_prev = 0.0
    end

    if self.tilt_t > 0.0 then
        self.tilt_t = math.max(0.0, self.tilt_t - dt)
        apply_tilt(self)
    end

    if self.squash > 0.0 then
        self.squash = math.max(0.0, self.squash - dt / SQUASH_DURATION)
        apply_squash(self)
    end
end

function on_input(self, action_id, action)
    if action.pressed or action.repeated then
        if action_id == hash("right") then
            move(self, 1)
        elseif action_id == hash("left") then
            move(self, -1)
        end
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("contact_point_response") then
        go.set("#collision_object", "linear_velocity", vmath.vector3(0.0, JUMP_SPEED, 0.0))
        self.squash = 1.0
        apply_squash(self)
    end
end
