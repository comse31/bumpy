-- Выход уровня: объект в финишной ячейке (timer_cell из метаданных).
-- Появляется, когда мяч собрал нужное число предметов (timer) — до этого
-- спрайт и надпись выключены. При получении сообщения "open" они включаются.
-- Надпись EXIT — label-компонент с общим шрифтом меню
-- (main/ui/fonts/plate.font): текст един с остальным интерфейсом и легко
-- меняется без правки текстуры.
go.property("open", 0)

local function set_visible(visible)
    -- имя переменной не "msg": оно затеняло бы глобальную msg из Defold
    local action = visible and "enable" or "disable"
    msg.post("#sprite", action)
    msg.post("#label", action)
end

local function show(self)
    self.open = 1
    set_visible(true)
end

function init(self)
    if self.open > 0 then
        show(self)
    else
        set_visible(false)
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("open") and self.open == 0 then
        show(self)
        print("EXIT opened")
    end
end
