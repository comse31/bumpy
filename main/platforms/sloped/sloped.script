-- наклонная (sloped) платформа: объект повёрнут на SLOPE_ANGLE в сторону наклона,
-- поэтому и визуал, и коллизия наклонены одинаково; текстура — как у default платформы
-- свойство direction есть у ВСЕХ платформ (0 = плоская): 1 = наклон вправо, -1 = влево,
-- 0 = без поворота; шар определяет направление наклона по повороту объекта
-- (go.get(url, "rotation"): отрицательный z = вправо, положительный = влево)
go.property("direction", 0)

local SLOPE_ANGLE = 10.0 -- угол наклона в градусах

function init(self)
    if self.direction ~= 0 then
        -- положительный поворот вокруг Z поднимает правый конец платформы
        -- (шар ушёл бы влево), поэтому для наклона вправо нужен отрицательный угол
        local dir = self.direction > 0 and 1 or -1
        go.set_rotation(vmath.quat_rotation_z(math.rad(-SLOPE_ANGLE * dir)))
    end
end
