-- визуальный прогиб платформы как батут: нижняя грань остаётся на месте,
-- верхняя грань прогибается вниз (спрайт сжимается по Y от нижней грани),
-- затем упруго возвращается с небольшим «отскоком» вверх;
-- коллизия при этом не меняется — эффект чисто визуальный
local HALF_H = 40.0 -- половина высоты текстуры спрайта (960x80) в локальных единицах
local BEND_AMOUNT = 0.25 -- доля сжатия: верхняя грань опускается на 2*HALF_H*BEND_AMOUNT
local DAMPING = 0.12 -- постоянная затухания упругого колебания
local OMEGA = 2.0 * math.pi / 0.35 -- частота колебания (период ~0.35 с)
local T_MAX = 0.7 -- максимальное время анимации

function init(self)
    self.bend_t = -1.0 -- -1: прогиб не активен
end

function update(self, dt)
    if self.bend_t >= 0.0 then
        self.bend_t = self.bend_t + dt
        local t = self.bend_t
        -- затухающее колебание: k=1 — максимальный прогиб вниз в момент отталкивания,
        -- затем k<0 — небольшой отскок вверх (батут), далее затухание к нулю
        local k = math.exp(-t / DAMPING) * math.cos(OMEGA * t)
        if t > T_MAX or math.abs(k) < 0.02 then
            self.bend_t = -1.0
            go.set("#sprite", "scale", vmath.vector3(1.0, 1.0, 1.0))
            go.set("#sprite", "position", vmath.vector3())
        else
            local a = k * BEND_AMOUNT
            -- нижняя грань зафиксирована: центр смещается вниз на HALF_H*a,
            -- верхняя грань опускается на 2*HALF_H*a (при a<0 — поднимается)
            go.set("#sprite", "scale", vmath.vector3(1.0, 1.0 - a, 1.0))
            go.set("#sprite", "position", vmath.vector3(0.0, -HALF_H * a, 0.0))
        end
    end
end

function on_message(self, message_id, message, sender)
    if message_id == hash("bend") then
        self.bend_t = 0.0
    end
end
