text: 'x 3'
font: '/main/ui/fonts/plate_small.font'
material: '/builtins/fonts/label.material'
# Ширина с запасом: подпись «x NN» ставится правым краем к следующей группе,
# pivot WEST — левый край подписи совпадает с переданной координатой.
size { x: 200 y: 46 z: 0 }
color { x: 1 y: 0.94 z: 0.94 w: 1 }
outline { x: 0.09 y: 0.10 z: 0.15 w: 1 }
shadow { x: 0 y: 0 z: 0 w: 0 }
leading: 1.0
tracking: 0.0
pivot: PIVOT_W
blend_mode: BLEND_MODE_ALPHA
line_break: false
