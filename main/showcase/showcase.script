-- White animation showcase. F2 toggles it; all v12 clips play in a 6x6 grid
-- plus mirrored jump-left / jump-right variants.
local CLIPS = require("main.bumpy_v12.bumpy_v12_clips")

local COLS = 6
local ROWS = 6
local START_X = 80.0
local STEP_X = 160.0
local START_Y = 650.0
local STEP_Y = 110.0
local SPRITE_SCALE = 0.32
local LABEL_DY = -48.0
local BUMPY_Z = 0.95
local LABEL_Z = 0.96
local RESTART_INTERVAL = 1.0

local EXTRA = {
    { name = "flight_feet_to_head", label = "ПРЫЖОК ВЛЕВО", mirror = -1 },
    { name = "flight_feet_to_head", label = "ПРЫЖОК ВПРАВО", mirror = 1 },
}

local function stop_all(self)
    for _, id in ipairs(self.created) do
        go.delete(id)
    end
    self.created = {}
    self.animations = {}
end

local function play_clip(id, clip)
    msg.post(msg.url(nil, id, "sprite"), "play_animation", { id = hash(clip) })
end

local function set_label(id, text)
    go.set(msg.url(nil, id, "label"), "text", text)
end

local function build_grid(self)
    stop_all(self)
    local index = 0
    for _, clip in ipairs(CLIPS) do
        local col = index % COLS
        local row = math.floor(index / COLS)
        local x = START_X + col * STEP_X
        local y = START_Y - row * STEP_Y
        local id = factory.create("#bumpy_factory",
            vmath.vector3(x, y, BUMPY_Z), nil, nil,
            vmath.vector3(SPRITE_SCALE, SPRITE_SCALE, 1.0))
        play_clip(id, clip.name)
        self.animations[#self.animations + 1] = { id = id, clip = clip.name }
        local label = factory.create("#label_factory",
            vmath.vector3(x, y + LABEL_DY, LABEL_Z))
        set_label(label, clip.name)
        self.created[#self.created + 1] = id
        self.created[#self.created + 1] = label
        index = index + 1
    end
    for _, extra in ipairs(EXTRA) do
        local col = index % COLS
        local row = math.floor(index / COLS)
        local x = START_X + col * STEP_X
        local y = START_Y - row * STEP_Y
        local scale_x = SPRITE_SCALE * extra.mirror
        local id = factory.create("#bumpy_factory",
            vmath.vector3(x, y, BUMPY_Z), nil, nil,
            vmath.vector3(scale_x, SPRITE_SCALE, 1.0))
        play_clip(id, extra.name)
        self.animations[#self.animations + 1] = { id = id, clip = extra.name }
        local label = factory.create("#label_factory",
            vmath.vector3(x, y + LABEL_DY, LABEL_Z))
        set_label(label, extra.label)
        self.created[#self.created + 1] = id
        self.created[#self.created + 1] = label
        index = index + 1
    end
end

local function show(self)
    if self.active then
        return
    end
    self.active = true
    self.restart_timer = 0.0
    msg.post("/ball", "disable")
    msg.post("#white", "enable")
    build_grid(self)
end

local function hide(self)
    if not self.active then
        return
    end
    self.active = false
    stop_all(self)
    msg.post("#white", "disable")
    msg.post("/ball", "enable")
    msg.post("/ball", "acquire_input_focus")
end

function init(self)
    self.active = false
    self.created = {}
    self.animations = {}
    self.restart_timer = 0.0
    msg.post("#white", "disable")
    msg.post(".", "acquire_input_focus")
end

function update(self, dt)
    if not self.active then
        return
    end
    self.restart_timer = self.restart_timer + dt
    if self.restart_timer < RESTART_INTERVAL then
        return
    end
    self.restart_timer = self.restart_timer - RESTART_INTERVAL
    for _, anim in ipairs(self.animations) do
        play_clip(anim.id, anim.clip)
    end
end

function on_input(self, action_id, action)
    if action_id == hash("showcase_toggle") and action.pressed then
        if self.active then
            hide(self)
        else
            show(self)
        end
        return true
    end
    return false
end
